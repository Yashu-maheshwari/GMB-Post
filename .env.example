# ==============================================================================
# GMB Post Automation Script Properties & OAuth Settings Example
# Copy this file to a private location or use it to populate Google Apps Script Properties.
# ==============================================================================

# Spark Integration Secret for Webhook Authentication (Header: X-SPARK-SECRET)
SPARK_SECRET=your_spark_secret_here

# Safety Switch (Set to 'true' to simulate postings, 'false' for live posting)
TEST_MODE=true

# Google Business Profile credentials (obtain via Google Cloud Console & OAuth)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_GBP_REFRESH_TOKEN=your_google_oauth_refresh_token
GOOGLE_GBP_ACCOUNT_ID=your_gbp_account_id
GOOGLE_GBP_LOCATION_ID=your_gbp_location_id

# Cloudinary public image hosting configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_unsigned_preset_name
